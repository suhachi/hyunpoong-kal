rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================================================
    // v1.0 개발용 규칙 (전부 허용)
    // ============================================================================
    // ⚠️ 주의: 이 규칙은 개발 단계용입니다.
    // 프로덕션 배포 전에는 반드시 아래 규칙을 엄격한 인증/권한 기반 규칙으로 교체해야 합니다.
    // 
    // TODO: v1.0 프로덕션 직전에는 아래 allow true 대신
    // - 인증된 사용자만 읽기/쓰기 가능
    // - storeId별 권한 체크
    // - 사용자는 자신의 데이터만 수정 가능
    // 등의 엄격한 규칙을 적용해야 합니다.
    // ============================================================================
    
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
